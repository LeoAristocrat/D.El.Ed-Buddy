---
import '../styles/global.css';
import {site} from '../data/site';
const {title = 'Your friendly companion for D.El.Ed.', description = 'Free study resources and the Semester 1 syllabus for D.El.Ed students in Assam. An independent student project by Sayeem Sadik.'} = Astro.props;
const path = Astro.url.pathname;
const nav = [['Home','/'],['Courses','/courses/'],['Study materials','/materials/'],['Practicals','/practicals/'],['Notices','/notices/'],['Resources','/resources/']];
---
<!doctype html><html lang="en"><head><meta charset="UTF-8"/><meta name="viewport" content="width=device-width"/><meta name="description" content={description}/><meta name="theme-color" content="#155e52"/><title>{title} | D.El.Ed Buddy</title><link rel="icon" href="/favicon.svg"/><link rel="canonical" href={new URL(path,site.origin).href}/><meta property="og:url" content={new URL(path,site.origin).href}/><meta property="og:title" content={`${title} | D.El.Ed Buddy`}/><meta property="og:description" content={description}/><meta property="og:type" content="website"/><script is:inline>try{if(localStorage.getItem('buddy-theme')==='dark')document.documentElement.dataset.theme='dark'}catch{}</script></head><body>
<a class="skip" href="#main">Skip to content</a>

<header class="header"><a class="brand" href="/" aria-label="D.El.Ed Buddy home"><span class="brand-icon">b<span>▱</span></span><span>D.El.Ed <strong>Buddy<span class="brand-dot">.</span></strong></span></a><nav aria-label="Main navigation">{nav.map(([name,url])=><a class:list={{active:url==='/'?path==='/':path.startsWith(url)}} href={url}>{name}</a>)}</nav><div class="header-actions"><a href="/saved/" class="icon-btn" aria-label="Saved resources"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M6 4h12v17l-6-4-6 4z"/></svg></a><button class="icon-btn" id="theme" aria-label="Switch to dark mode">◐</button><button class="icon-btn menu-toggle" id="menu" aria-label="Open navigation" aria-expanded="false">☰</button></div></header>
<main id="main"><slot/></main>
<footer><div class="footer-top"><div><a class="brand" href="/">D.El.Ed <strong>Buddy.</strong></a><p>Your friendly companion for D.El.Ed.</p><p class="small">Made with care by <a href="/about/">Sayeem Sadik / Leo Aristocrat</a></p></div><div class="footer-links"><a href="/courses/">Courses</a><a href="/materials/">Study materials</a><a href="/internship/">School internship</a><a href="/about/">About & credits</a><a href="/updates/">What’s new</a><a href="/about/#contact">Contact</a></div></div><div class="disclaimer">Independent student project · <a href="/about/#disclaimer">Disclaimer & sources</a></div><div class="footer-bottom"><span>© 2026 D.El.Ed Buddy · Free to study. Free to grow.</span><span><a href="/about/#disclaimer">Disclaimer</a> · <a href="/privacy/">Privacy</a></span></div></footer>
<script>import '../scripts/client';</script>
</body></html>

---
import '../styles/global.css';
import '../styles/motion.css';
import '../styles/card-depth.css';
import Icon from '../components/Icon.astro';
import BrandLogo from '../components/BrandLogo.astro';
import Starfield from '../components/Starfield.astro';
import {site} from '../data/site';
const {title = 'Your friendly companion for D.El.Ed.', description = 'Free study resources and the Semester 1 syllabus for D.El.Ed students in Assam. An independent student project by Sayeem Sadik.'} = Astro.props;
const path = Astro.url.pathname;
const nav = [['Home','/'],['Courses','/courses/'],['Study materials','/materials/'],['Practicals','/practicals/'],['Notices','/notices/'],['Resources','/resources/'],['Tools','/tools/'],['Contribute','/contribute/']];
---
<!doctype html><html lang="en"><head><meta charset="UTF-8"/><meta name="viewport" content="width=device-width"/><meta name="description" content={description}/><meta name="theme-color" content="#155e52"/><title>{title} | D.El.Ed Buddy</title><link rel="icon" type="image/svg+xml" href="/favicon.svg?v=transparent-books"/><link rel="apple-touch-icon" href="/brand/deled-buddy-transparent.png"/><link rel="canonical" href={new URL(path,site.origin).href}/><meta property="og:url" content={new URL(path,site.origin).href}/><meta property="og:title" content={`${title} | D.El.Ed Buddy`}/><meta property="og:description" content={description}/><meta property="og:type" content="website"/><meta property="og:image" content={new URL("/brand/deled-buddy-transparent.png",site.origin).href}/><meta property="og:image:alt" content="D.El.Ed Buddy logo: stacked books above the D.El.Ed Buddy name"/><meta name="twitter:card" content="summary"/><meta name="twitter:image" content={new URL("/brand/deled-buddy-transparent.png",site.origin).href}/><script is:inline>try{const t=localStorage.getItem('buddy-theme');if(['light','dark','mocha','monochrome','dracula','hacker'].includes(t))document.documentElement.dataset.theme=t}catch{}</script></head><body>
<a class="skip" href="#main">Skip to content</a>
<Starfield />

<div class="nav-sentinel" aria-hidden="true"></div>
<header class="header">
  <a class="brand" href="/" aria-label="D.El.Ed Buddy home"><BrandLogo /></a>
  <nav id="main-navigation" aria-label="Main navigation">{nav.map(([name,url])=><a class:list={{active:url==='/'?path==='/':path.startsWith(url)}} aria-current={(url==='/'?path==='/':path.startsWith(url))?'page':undefined} href={url}>{name}</a>)}<a class="nav-support" href="/about/#support"><Icon name="coffee" size={17}/> Support</a></nav>
  <div class="header-actions">
    <a href="/saved/" class="icon-btn" aria-label="Saved resources" title="Saved resources"><Icon name="bookmark" size={19}/></a>
    <details class="theme-picker"><summary class="icon-btn" aria-label="Choose colour theme" title="Choose theme"><Icon name="sun" size={19}/></summary><div class="theme-panel"><label for="theme">Make yourself at home.</label><select id="theme"><option value="light">Light</option><option value="dark">Dark</option><option value="mocha">Catppuccin Mocha</option><option value="monochrome">Monochrome</option><option value="dracula">Dracula</option><option value="hacker">Hacker</option></select></div></details>
    <button class="icon-btn menu-toggle" id="menu" aria-label="Open navigation" aria-controls="main-navigation" aria-expanded="false"><Icon name="menu" class="menu-open-icon"/><Icon name="close" class="menu-close-icon"/></button>
  </div>
</header>
<main id="main"><slot/></main>
<footer><div class="footer-top"><div><a class="brand" href="/" aria-label="D.El.Ed Buddy home"><BrandLogo /></a><p>Your friendly companion for D.El.Ed.</p><p class="small">Made with care by <a href="/about/">Sayeem Sadik / Leo Aristocrat</a></p></div><div class="footer-links"><a href="/courses/">Courses</a><a href="/materials/">Study materials</a><a href="/internship/">School internship</a><a href="/tools/">Student tools</a><a href="/about/">About & credits</a><a href="/about/#contact">Contact</a><a href="/about/#support">Support the project</a><a href="/contribute/">Contribute</a><a href={`/contribute/?page=${encodeURIComponent(path)}#report-issue`}>Report an issue</a></div></div><div class="disclaimer">Independent student project · <a href="/about/#disclaimer">Disclaimer & sources</a></div><div class="footer-bottom"><span>© 2026 D.El.Ed Buddy · Free to study. Free to grow.</span><span><a href="/about/#disclaimer">Disclaimer</a> · <a href="/privacy/">Privacy</a></span></div></footer>
<div id="buddy-toast" class="toast" role="status" aria-live="polite" aria-atomic="true"></div>
<script>import '../scripts/client';import '../scripts/motion';</script>
</body></html>

---
import Layout from '../../../layouts/Layout.astro';import PageHeader from '../../../components/PageHeader.astro';import CourseCard from '../../../components/CourseCard.astro';import courses from '../../../data/courses.json';
export function getStaticPaths(){return [1,2,3,4].map(n=>({params:{semester:`semester-${n}`},props:{n}}))}const {n}=Astro.props;
---
<Layout title={`Semester ${n}`}><div class="wrap"><PageHeader title={`Semester ${n}`} description={n===1?'Your first semester, all in one place. Choose a course to see its official units, topics and available resources.':'This part of the journey is coming later. Semester 1 is the focus for now.'}/>{n===1?<><div class="stats-row"><span><strong>9</strong> courses</span><span><strong>37</strong> units</span><span><strong>20</strong> credits</span><span><strong>500</strong> total marks</span></div><div class="progress-box"><label for="semester-progress">Your unit progress <span id="semester-percent">0%</span></label><progress id="semester-progress" max="37" value="0"></progress><p class="small muted">Completed units · saved on this browser only</p></div><div class="grid">{courses.map((c,i)=><CourseCard course={c} index={i}/>)}</div><a class="internship-banner" href="/internship/"><div><span class="eyebrow">SI-I · TWO WEEKS</span><h3>School Internship - I</h3><p>50 marks included within the course totals, not added to 500.</p></div><span>View activities ↗</span></a><p class="small muted spaced">Source: SCERT Assam, Revised Curriculum-Syllabus 2024, printed page vi (PDF page 8). <a href="/curriculum-2024.pdf#page=8">Open source ↗</a></p></>:<div class="empty"><h2>Coming later</h2><p>No study material has been published for Semester {n}.</p><a class="button" href="/courses/semester-1/">Browse Semester 1 →</a></div>}</div></Layout>

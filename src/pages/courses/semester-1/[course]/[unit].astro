---
import Layout from '../../../../layouts/Layout.astro';import PageHeader from '../../../../components/PageHeader.astro';import StudyFormats from '../../../../components/StudyFormats.astro';import courses from '../../../../data/courses.json';import {getCollection} from 'astro:content';import ResourceCard from '../../../../components/ResourceCard.astro';
export function getStaticPaths(){return courses.flatMap(c=>c.units.map(u=>({params:{course:c.id,unit:`unit-${u.number}`},props:{c,u}})))}const {c,u}=Astro.props;const key=`${c.id}-${u.number}`;const resources=await getCollection('resources',({data})=>data.status==='published'&&data.course===c.id&&(data.unit===u.number||data.coversUnits?.includes(u.number)));
---
<Layout title={`${c.code} Unit ${u.number} · ${u.title}`} description={`Official syllabus topics and study resources for ${u.title}.`}><div class="wrap"><PageHeader title={u.title} kicker={`${c.code} · UNIT ${u.number}`} description={c.title} back={`/courses/semester-1/${c.id}/`} backLabel={c.code}/><div class="reader-layout"><article><div class="content-panel"><span class="badge">Official syllabus · SCERT Assam</span><h2>What’s in this unit?</h2><ol class="syllabus-topics">{u.topics.map(t=><li>{t}</li>)}</ol><div class="source-note"><p>Source: Revised Curriculum-Syllabus 2024, PDF page {u.page} (printed page {u.page-11}). Original numbering and terminology are retained. Minor spacing has been cleaned up.</p><a href={`/curriculum-2024.pdf#page=${u.page}`} class="text-link">Check the original page ↗</a></div></div><section class="section"><h2>Notes, revision & practice</h2><StudyFormats course={c.id} unit={u.number}/>{resources.length?<div class="grid spaced">{resources.map(r=><ResourceCard resource={r} unit={u.number}/>)}</div>:<div class="empty spaced"><h3>Notes are being prepared.</h3><p>This section will grow as the semester progresses. Use the official topic list to organize your class notes for now.</p><p class="small">Explanations, key concepts, full notes, short notes, questions, quizzes, infographics and PDFs need supporting sources and review before publication.</p></div>}</section></article><aside class="reader-aside"><div class="content-panel"><span class="eyebrow">YOUR STUDY CORNER</span><h3>One unit at a time.</h3><label for="unit-progress">My progress</label><select id="unit-progress" data-progress={key}><option value="not-started">Not started</option><option value="in-progress">In progress</option><option value="completed">Completed</option></select><button class="button secondary full" data-bookmark={key} data-bookmark-title={`${c.code} · ${u.title}`}>Save this unit</button><p class="small muted spaced">Saved on this browser. No account needed.</p><p id="storage-message" class="small" role="status"></p></div><div class="content-panel"><h3>Keep the source close</h3><p class="small muted">The curriculum gives the outline. Your teacher’s notes and referenced readings add the explanation.</p><a class="text-link" href="/curriculum-2024.pdf" download>Download curriculum PDF ↓</a></div></aside></div><div class="page-turn"><a href={`/courses/semester-1/${c.id}/`}>← All units</a>{u.number<c.units.length&&<a href={`/courses/semester-1/${c.id}/unit-${u.number+1}/`}>Next unit →</a>}</div></div></Layout>

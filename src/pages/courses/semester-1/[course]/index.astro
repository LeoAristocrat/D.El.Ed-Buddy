---
import Layout from '../../../../layouts/Layout.astro';import PageHeader from '../../../../components/PageHeader.astro';import StudyFormats from '../../../../components/StudyFormats.astro';import courses from '../../../../data/courses.json';import {getCollection} from 'astro:content';import ResourceCard from '../../../../components/ResourceCard.astro';
export function getStaticPaths(){return courses.map(c=>({params:{course:c.id},props:{c}}))}const {c}=Astro.props;const resources=await getCollection('resources',({data})=>data.status==='published'&&data.course===c.id);
---
<Layout title={`${c.code} · ${c.title}`} description={c.summary}><div class="wrap"><PageHeader title={c.title} description={c.summary} kicker={`${c.code} · SEMESTER 1`} back="/courses/semester-1/" backLabel="Semester 1"/><div class="stats-row"><span><strong>{c.credits}</strong> credits</span><span><strong>{c.marks}</strong> total marks</span><span>{c.external} external · {c.internal} internal · {c.sipMarks} SIP</span></div><div class="actions"><a class="button" href={`/curriculum-2024.pdf#page=${c.sourcePages[0]}`}>Open official syllabus ↗</a><a class="button secondary" href={`/practicals/#${c.id}`}>Practicum & activities</a></div>{c.id==='s1-1'&&<aside class="source-note"><strong>A naming difference in the source</strong><p>The programme table calls this course “Childhood, Child Protection and the Development of Children”. The detailed paper is headed “GROWTH, DEVELOPMENT AND PROTECTION OF CHILDREN”. Both appear in the supplied 2024 curriculum; this site uses the programme-table title.</p></aside>}<section class="section"><div class="section-heading"><div><span class="eyebrow">THE OFFICIAL OUTLINE</span><h2>Your units</h2></div><span class="badge">SCERT Assam · 2024</span></div><div class="unit-list">{c.units.map(u=><a href={`/courses/semester-1/${c.id}/unit-${u.number}/`} class="unit-row"><span class="unit-number">{String(u.number).padStart(2,'0')}</span><div><h3>{u.title}</h3><p>Official topics · PDF page {u.page}</p></div><span class="unit-status" data-unit-status={`${c.id}-${u.number}`}>Not started</span><span aria-hidden="true">↗</span></a>)}</div></section><section class="section"><h2>Study your way</h2><StudyFormats course={c.id}/>{resources.length>0&&<div class="grid spaced">{resources.map(r=><ResourceCard resource={r}/>)}</div>}</section><section class="section"><details><summary>References from the curriculum</summary><p class="small muted">Transcribed from the supplied syllabus. A listed reference is not a claim that its content has been reviewed or is available on this site.</p><div class="source-text">{c.references}</div><a class="text-link" href={`/curriculum-2024.pdf#page=${c.sourcePages[1]}`}>Verify in the original PDF ↗</a></details></section></div></Layout>

---
import Layout from '../../layouts/Layout.astro';import PageHeader from '../../components/PageHeader.astro';import ResourceCard from '../../components/ResourceCard.astro';import courses from '../../data/courses.json';import {resourceTypes} from '../../data/site';import {getCollection} from 'astro:content';const resources=(await getCollection('resources',({data})=>data.status==='published')).sort((a,b)=>b.data.updatedDate.localeCompare(a.data.updatedDate));
---
<Layout title="Study materials"><div class="wrap"><PageHeader title="Find your next study resource." description="Official references are ready. Student notes and subject practice will appear as they are prepared and reviewed." kicker="THE STUDY SHELF" back="/materials/" backLabel="Study materials"/><form class="filter-bar" id="resource-filters"><label>Course<select name="course"><option value="">All courses</option>{courses.map(c=><option value={c.id}>{c.code} · {c.title}</option>)}</select></label><label>Unit<select name="unit"><option value="">All units</option>{[1,2,3,4,5,6].map(n=><option value={n}>Unit {n}</option>)}</select></label><label>Resource type<select name="type"><option value="">All types</option>{[...resourceTypes,'Reference'].map(t=><option>{t}</option>)}</select></label><label>Level<select name="difficulty"><option value="">All levels</option>{['Getting started','Core','Practice'].map(t=><option>{t}</option>)}</select></label><button type="reset" class="button secondary">Reset</button></form><p id="filter-count" class="small muted" aria-live="polite">{resources.length} published resources</p><div class="grid">{resources.map(r=><ResourceCard resource={r}/>)}</div><div class="empty" id="resource-empty" hidden><h2>Nothing on this shelf yet.</h2><p>Materials for this selection are being prepared. Try another filter or browse the official course topics.</p><a href="/courses/semester-1/" class="text-link">Browse Semester 1 →</a></div><section class="section"><div class="feature-panel"><span class="eyebrow">GET TO KNOW YOUR COURSE</span><h2>A quick curriculum check</h2><p>Five questions about the Semester 1 structure. This is an orientation activity, not a subject exam quiz.</p><a class="button" href="/quiz/">Try the curriculum check →</a></div></section></div></Layout>

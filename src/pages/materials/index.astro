---
import Layout from '../../layouts/Layout.astro';import PageHeader from '../../components/PageHeader.astro';import ResourceCard from '../../components/ResourceCard.astro';import courses from '../../data/courses.json';import {resourceTypes,studyFormats} from '../../data/site';import {getCollection} from 'astro:content';const resources=(await getCollection('resources',({data})=>data.status==='published')).sort((a,b)=>b.data.updatedDate.localeCompare(a.data.updatedDate)||Number(!!b.data.htmlFile)-Number(!!a.data.htmlFile));
---
<Layout title="Study materials"><div class="wrap"><PageHeader title="Find your next study resource." description="Notes and resources, organized by subject." kicker="THE STUDY SHELF" back="/materials/" backLabel="Study materials"/><p><a class="text-link" href="/pyqs/">Browse previous year question papers by year →</a></p><details class="format-help"><summary>Choose your study format</summary>{studyFormats.map(({type,description})=><p><strong>{type}:</strong> {description}</p>)}</details><form class="filter-bar" id="resource-filters"><label>Course<select name="course"><option value="">All courses</option>{courses.map(c=><option value={c.id}>{c.code} · {c.title}</option>)}</select></label><label>Unit<select name="unit"><option value="">All units</option>{[1,2,3,4,5,6].map(n=><option value={n}>Unit {n}</option>)}</select></label><label>Resource type<select name="type"><option value="">All types</option>{[...resourceTypes,'Reference'].map(t=><option>{t}</option>)}</select></label><button type="reset" class="button secondary">Reset</button></form><p id="filter-count" class="small muted" aria-live="polite">{resources.length} published resources</p><div class="grid">{resources.map(r=><ResourceCard resource={r}/>)}</div><div class="empty" id="resource-empty" hidden><h2>Nothing on this shelf yet.</h2><p>Materials for this selection are being prepared. Try another filter or browse the official course topics.</p><a href="/courses/semester-1/" class="text-link">Browse Semester 1 →</a></div></div></Layout>

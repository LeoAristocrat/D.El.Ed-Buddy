---
import Layout from '../../layouts/Layout.astro';import PageHeader from '../../components/PageHeader.astro';import {getCollection,render} from 'astro:content';
import McqBank from '../../components/McqBank.astro';
import PdfReader from '../../components/PdfReader.astro';
import QuestionAnswers from '../../components/QuestionAnswers.astro';
import Quiz from '../../components/Quiz.astro';
export async function getStaticPaths(){return (await getCollection('resources',({data})=>data.status==='published')).map(r=>({params:{id:r.id},props:{r}}))}const {r}=Astro.props;const {Content}=await render(r);const d=r.data;const pyqYear=d.type==='Previous Year Questions (PYQs)'?r.id.match(/\/pyqs-(\d{4})$/)?.[1]:undefined;
---
<Layout title={d.title} description={d.description}><div class="wrap"><PageHeader title={d.title} description={d.htmlFile||d.imageFile?undefined:d.description} kicker={d.type} back={pyqYear?`/pyqs/${pyqYear}/`:d.course?`/courses/semester-1/${d.course}/`:'/materials/'} backLabel={pyqYear?`${pyqYear} papers`:d.course?d.course.replace('s1-','S1.'):'Study materials'}/>
{d.qaBank&&d.course&&d.unit?<QuestionAnswers course={d.course} unit={d.unit} title={d.title} resourceId={r.id}/>:d.type==='Previous Year Questions (PYQs)'&&d.pdf?<PdfReader file={d.pdf} title={d.title} resourceId={r.id} author={d.author}/>:d.type==='Multiple Choice Questions(MCQs)'&&!d.questions?<McqBank course={d.course}/>:d.imageFile?<section class="infographic-reader"><div class="notes-toolbar"><span class="small muted">By {d.author}</span><div class="actions"><a class="button" href={d.imageFile} target="_blank" rel="noopener">View full size ↗</a><a class="button secondary" href={d.imageFile} download={`${d.course}-unit-${d.unit}-infographic.png`}>Download image ↓</a><button class="button secondary" data-bookmark={`resource-${r.id}`} data-bookmark-title={d.title}>Save resource</button></div></div><p id="storage-message" role="status" class="small"></p><a href={d.imageFile} target="_blank" rel="noopener" aria-label={`View ${d.title} at full size`}><img src={d.imageFile} alt={d.title} width="1024" height="1536" style="display:block;width:100%;max-width:1024px;height:auto;margin:0 auto" /></a></section>:d.htmlFile?<section class="uploaded-notes"><div class="notes-toolbar"><span class="small muted">By {d.author}</span><div class="actions"><a class="button" id="open-study-notes" href={d.htmlFile} target="_blank" rel="noopener">Read full screen ↗</a>{d.pdf&&<a class="button secondary" href={d.pdf} download>Download PDF ↓</a>}<button class="button secondary" data-bookmark={`resource-${r.id}`} data-bookmark-title={d.title}>Save resource</button></div></div><p id="storage-message" role="status" class="small"></p><iframe id="study-notes-frame" src={d.htmlFile} data-file={d.htmlFile} data-units={(d.coversUnits||[]).join(',')} title={d.title} sandbox="allow-scripts allow-popups allow-downloads" loading="lazy" referrerpolicy="no-referrer"></iframe></section>:<div class="reader-layout"><article class="content-panel prose"><div class="resource-meta">{d.author} · Updated {d.updatedDate}{d.reviewedBy&&<span> · Reviewed by {d.reviewedBy}</span>}</div><Content/>{d.questions&&<Quiz questions={d.questions} label="Practice quiz"/>}<details class="spaced"><summary>Source & references</summary><p>{d.source}</p>{d.sourcePage&&<a class="text-link" href={`/curriculum-2024.pdf#page=${d.sourcePage}`}>Open source page {d.sourcePage} ↗</a>}</details></article><aside><div class="content-panel"><button class="button secondary full" data-bookmark={`resource-${r.id}`} data-bookmark-title={d.title}>Save resource</button>{d.pdf&&<a class="button full spaced" href={d.pdf} download>Download PDF ↓</a>}<p id="storage-message" role="status" class="small"></p></div></aside></div>}
<p class="resource-report"><a class="text-link" href={`/contribute/?page=${encodeURIComponent(`/materials/${r.id}/`)}#report-issue`}>Report an issue with this resource</a></p></div></Layout>
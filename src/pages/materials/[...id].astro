---
import Layout from '../../layouts/Layout.astro';import PageHeader from '../../components/PageHeader.astro';import {getCollection,render} from 'astro:content';
import Quiz from '../../components/Quiz.astro';
export async function getStaticPaths(){return (await getCollection('resources',({data})=>data.status==='published')).map(r=>({params:{id:r.id},props:{r}}))}const {r}=Astro.props;const {Content}=await render(r);const d=r.data;
---
<Layout title={d.title} description={d.description}><div class="wrap"><PageHeader title={d.title} description={d.description} kicker={`${d.type} · ${d.origin}`} back="/materials/" backLabel="Study materials"/><div class="reader-layout"><article class="content-panel prose"><div class="resource-meta">{d.author} · Updated {d.updatedDate} · Syllabus {d.syllabusVersion}{d.reviewedBy&&<span> · Reviewed by {d.reviewedBy}</span>}</div><Content/>{d.questions&&<Quiz questions={d.questions} label={`${d.origin} · practice quiz`}/>}<div class="source-note"><strong>Source / references</strong><p>{d.source}</p>{d.sourcePage&&<a class="text-link" href={`/curriculum-2024.pdf#page=${d.sourcePage}`}>Open source page {d.sourcePage} ↗</a>}</div></article><aside><div class="content-panel"><h3>Keep it handy</h3><button class="button secondary full" data-bookmark={`resource-${r.id}`} data-bookmark-title={d.title}>Save resource</button>{d.pdf&&<a class="button full spaced" href={d.pdf} download>Download PDF ↓</a>}<button class="text-button spaced" data-print>Print this page</button><p class="small muted spaced">Your bookmarks stay on this browser.</p><p id="storage-message" role="status" class="small"></p></div></aside></div></div></Layout>

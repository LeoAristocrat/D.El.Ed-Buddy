---
import Layout from '../../layouts/Layout.astro';import PageHeader from '../../components/PageHeader.astro';import {getCollection,render} from 'astro:content';
import Quiz from '../../components/Quiz.astro';
export async function getStaticPaths(){return (await getCollection('resources',({data})=>data.status==='published')).map(r=>({params:{id:r.id},props:{r}}))}const {r}=Astro.props;const {Content}=await render(r);const d=r.data;
---
<Layout title={d.title} description={d.description}><div class="wrap"><PageHeader title={d.title} description={d.htmlFile?undefined:d.description} kicker={d.type} back={d.course?`/courses/semester-1/${d.course}/`:'/materials/'} backLabel={d.course?d.course.replace('s1-','S1.'):'Study materials'}/>
{d.htmlFile?<section class="uploaded-notes"><div class="notes-toolbar"><span class="small muted">By {d.author}</span><div class="actions"><a class="button" id="open-study-notes" href={d.htmlFile} target="_blank" rel="noopener">Read full screen ↗</a><a class="button secondary" href={d.htmlFile} download>Download ↓</a><button class="button secondary" data-bookmark={`resource-${r.id}`} data-bookmark-title={d.title}>Save resource</button></div></div><p id="storage-message" role="status" class="small"></p><iframe id="study-notes-frame" src={d.htmlFile} data-file={d.htmlFile} data-units={(d.coversUnits||[]).join(',')} title={d.title} sandbox="allow-scripts allow-popups" loading="lazy" referrerpolicy="no-referrer"></iframe></section>:<div class="reader-layout"><article class="content-panel prose"><div class="resource-meta">{d.author} · Updated {d.updatedDate}{d.reviewedBy&&<span> · Reviewed by {d.reviewedBy}</span>}</div><Content/>{d.questions&&<Quiz questions={d.questions} label="Practice quiz"/>}<details class="spaced"><summary>Source & references</summary><p>{d.source}</p>{d.sourcePage&&<a class="text-link" href={`/curriculum-2024.pdf#page=${d.sourcePage}`}>Open source page {d.sourcePage} ↗</a>}</details></article><aside><div class="content-panel"><button class="button secondary full" data-bookmark={`resource-${r.id}`} data-bookmark-title={d.title}>Save resource</button>{d.pdf&&<a class="button full spaced" href={d.pdf} download>Download PDF ↓</a>}<button class="text-button spaced" data-print>Print this page</button><p id="storage-message" role="status" class="small"></p></div></aside></div>}
</div></Layout>
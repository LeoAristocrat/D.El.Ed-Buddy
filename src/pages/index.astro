---
import Layout from '../layouts/Layout.astro';
import courses from '../data/courses.json';
import CourseCard from '../components/CourseCard.astro';
import ResourceCard from '../components/ResourceCard.astro';
import {getCollection} from 'astro:content';
import {resourceTypes} from '../data/site';
const recent=(await getCollection('resources',({data})=>data.status==='published')).sort((a,b)=>b.data.updatedDate.localeCompare(a.data.updatedDate)||Number(!!b.data.htmlFile)-Number(!!a.data.htmlFile)).slice(0,3);
const notices=(await getCollection('notices',({data})=>data.status==='published')).sort((a,b)=>b.data.date.localeCompare(a.data.date)).slice(0,2);
---
<Layout>
<section class="hero wrap"><div class="hero-copy"><div class="eyebrow"><span class="pill">FOR D.EL.ED STUDENTS, ASSAM</span><span class="edition">2024 curriculum</span></div><h1>A little clarity.<br/>A lot more <em>confidence.</em></h1><p class="tagline">Your friendly companion for D.El.Ed.</p><p class="hero-description">Your syllabus, study resources and practical work — finding their place, one class at a time. Let’s make Semester 1 a little easier.</p><div class="actions"><a class="button" href="/courses/semester-1/">Explore Semester 1 <span>↗</span></a><a class="text-link" href="/materials/">Find study materials →</a></div><div class="hero-foot"><span>✓ Always free</span><span>✓ No account needed</span><span>✓ Built by a fellow student</span></div></div><aside class="semester-note"><div class="note-top"><span>YOUR STARTING POINT</span><span>01 / 04</span></div><h2>Small steps. <br/>Strong foundations.</h2><p>Semester 1</p><div class="note-rule"></div><div class="note-stats"><div><strong>9</strong><span>courses</span></div><div><strong>20</strong><span>credits</span></div><div><strong>2</strong><span>weeks of internship</span></div></div><a href="/courses/semester-1/">Open your semester <span>↗</span></a><div class="note-caption">A new chapter in becoming a teacher.</div></aside></section>
<section class="search-strip wrap"><span class="search-symbol">⌕</span><form action="/search/"><label class="sr-only" for="home-search">Search the website</label><input id="home-search" name="q" placeholder="What are you studying today? Try “Piaget” or “S1.1”"/><button class="button" type="submit">Search <span>→</span></button></form></section>
<section class="wrap section"><div class="section-heading"><div><div class="eyebrow">YOUR SEMESTER, ORGANIZED</div><h2>Start with your subject</h2></div><a class="text-link" href="/courses/">View all semesters ↗</a></div><div class="semester-tabs"><a class="selected" href="/courses/semester-1/">Semester 1 <span>Available</span></a>{[2,3,4].map(n=><a href={`/courses/semester-${n}/`}>Semester {n}<span>Coming later</span></a>)}</div><div class="grid">{courses.map((c,i)=><CourseCard course={c} index={i}/>)}</div><a class="internship-banner" href="/internship/"><span class="course-symbol">⌂</span><div><span class="eyebrow">SI-I · TWO WEEKS</span><h3>Your first step into the classroom</h3><p>School Internship - I · Activities, source details and a preparation checklist</p></div><span>Explore internship ↗</span></a></section>
<section class="wrap section"><div class="section-heading"><div><span class="eyebrow">FRESH ON THE SHELF</span><h2>Recently added</h2></div><a class="text-link" href="/updates/">What’s new ↗</a></div><div class="two-col"><div class="recent-grid">{recent.map(r=><ResourceCard resource={r}/>)}</div><aside class="notice-panel"><div class="section-heading"><h3>The notice board</h3><span class="notice-pin" aria-hidden="true">⌁</span></div>{notices.length?notices.map(({data:n})=><article><span class="badge">{n.category} · {n.date}</span><h3><a href={n.originalUrl}>{n.title}</a></h3><p>{n.summary}</p><span class="small">Source: {n.source}</span></article>):<><p>No verified notices added yet.</p><p class="small muted">For current official announcements, check SCERT Assam or your institution.</p></>}<a href="/notices/" class="text-link">Visit the notice board →</a></aside></div></section>
<section class="wrap section"><div class="section-heading"><div><span class="eyebrow">MAKE IT YOUR STUDY SESSION</span><h2>How do you like to revise?</h2></div><a href="/materials/" class="text-link">Browse materials ↗</a></div><div class="format-grid home-formats">{resourceTypes.map((type,i)=><a href={`/materials/?type=${encodeURIComponent(type)}`}><span class="format-number">{String(i+1).padStart(2,'0')}</span><span>{type}</span><span>↗</span></a>)}</div><p class="small muted">Study Notes are ready for all nine subjects. Detailed Notes and one-page unit Infographics are coming later.</p></section>
<section class="wrap section"><div class="official-strip"><div><span class="eyebrow">KEEP THE ORIGINAL CLOSE</span><h3>SCERT Assam · Revised Curriculum 2024</h3><p>The source behind every course outline here.</p></div><a class="button secondary" href="/resources/">Official resources ↗</a></div></section>
<section class="wrap section"><div class="two-col"><div class="feature-panel"><span class="eyebrow">FROM CLASSROOM TO CLASSROOM</span><h2>Good teachers start<br/>as curious students.</h2><p>I’m Sayeem, a D.El.Ed student too. This is where I’m bringing the syllabus, useful resources and my generated study notes together. It’ll grow as we go.</p><a href="/about/" class="text-link">A little about this project ↗</a></div><div class="side-panel"><span class="eyebrow">A NOTE BEFORE YOU BEGIN</span><h3>A growing notebook,<br/>not a finished library.</h3><p>The official syllabus comes first. The supplied Study Notes are available now; more detailed resources will follow. You’ll always be able to tell what’s official and what’s student-created.</p><a href="/resources/">Find the original sources →</a></div></div></section>
</Layout>

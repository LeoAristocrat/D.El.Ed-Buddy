---
import Layout from '../layouts/Layout.astro';
import courses from '../data/courses.json';
import CourseCard from '../components/CourseCard.astro';
import StudyFolio from '../components/StudyFolio.astro';
import Icon from '../components/Icon.astro';
import {resourceTypes} from '../data/site';
const formats = [
  {icon:'book',description:'A focused read, without the overwhelm.'},
  {icon:'layers',description:'The full picture, topic by topic.'},
  {icon:'image',description:'A whole unit. One visual.'},
  {icon:'list',description:'Check what has actually clicked.'},
  {icon:'questions',description:'Work through the questions that matter.'},
  {icon:'paper',description:'Get familiar with the paper.'},
];
---
<Layout>
<div class="home-intro">
  <section class="hero wrap">
    <div class="hero-copy">
      <div class="eyebrow hero-eyebrow"><span class="status-dot" aria-hidden="true"></span>FOR THE “BRO, SEND THE NOTES” CROWD</div>
      <h1><span>Everything</span><span>D.El.Ed.</span><em>in one place.</em></h1>
      <p class="tagline">Because hunting through WhatsApp, Telegram, Drive and random PDFs gets old real quick.</p>
      <p class="hero-description">Notes, practicals, study stuff, notices — basically the things you keep looking for at 11 PM.</p>
      <div class="actions"><a class="button" href="/courses/semester-1/">Start studying <Icon name="arrow-up-right" size={18}/></a><a class="text-link" href="/materials/">Browse materials <Icon name="arrow-right" size={18}/></a></div>
      <div class="hero-foot"><span><Icon name="check" size={15}/>Free to study</span><span><Icon name="check" size={15}/>Ad-free, always focused</span></div>
    </div>
    <StudyFolio/>
  </section>
  <div class="wrap"><section class="home-search" aria-label="Search study resources"><div><span class="eyebrow">SKIP THE SCROLL</span><span>Looking for something?</span></div><form action="/search/" class="search-strip"><Icon name="search"/><label class="sr-only" for="home-search">Search the website</label><input id="home-search" type="search" name="q" placeholder="Try “Piaget” or “S1.1”"/><button class="button" type="submit"><span>Search</span><Icon name="arrow-right" size={18}/></button></form></section></div>
</div>
<section class="wrap section home-courses" data-reveal>
  <div class="section-heading"><div><div class="eyebrow">01 / YOUR SEMESTER, ORGANIZED</div><h2>Start with your subject<span class="accent-dot">.</span></h2></div><a class="text-link" href="/courses/">View all semesters <Icon name="arrow-up-right" size={17}/></a></div>
  <nav class="semester-tabs" aria-label="Semesters"><a class="selected" href="/courses/semester-1/">Semester 1 <span><i class="status-dot" aria-hidden="true"></i>Available</span></a>{[2,3,4].map(n=><a href={`/courses/semester-${n}/`}>Semester {n}<span>Coming later</span></a>)}</nav>
  <div class="grid course-grid">{courses.map((c,i)=><CourseCard course={c} index={i}/>)}</div>
  <a class="internship-banner" href="/internship/"><span class="course-symbol"><Icon name="school" size={28}/></span><div><span class="eyebrow">BEYOND THE NOTES / SI-I</span><h3>Your first step into the classroom</h3><p>School Internship - I · Activities and a preparation checklist</p></div><span>Explore internship <Icon name="arrow-up-right" size={18}/></span></a>
</section>
<section class="wrap section" data-reveal>
  <div class="section-heading"><div><span class="eyebrow">02 / MAKE IT YOUR STUDY SESSION</span><h2>Your pace. Your way<span class="accent-dot">.</span></h2></div><a href="/materials/" class="text-link">Browse materials <Icon name="arrow-up-right" size={17}/></a></div>
  <div class="format-grid home-formats">{resourceTypes.map((type,i)=><a href={`/materials/?type=${encodeURIComponent(type)}`}><span class="format-icon"><Icon name={formats[i].icon} size={25}/></span><span class="format-copy"><strong>{type}</strong><small>{formats[i].description}</small></span><Icon name="arrow-up-right" size={18}/></a>)}</div>
</section>
<section class="wrap section" data-reveal><div class="official-strip"><div><span class="eyebrow">STRAIGHT FROM THE SOURCE</span><h3>SCERT Assam · Official curriculum</h3><p>The source behind every course outline here.</p></div><a class="text-link" href="/resources/">Official resources <Icon name="arrow-up-right" size={18}/></a></div></section>
<section class="wrap section" aria-labelledby="home-support-title" data-reveal><div class="home-support"><span class="support-mark" aria-hidden="true"><Icon name="coffee" size={40}/></span><div><span class="eyebrow">A STUDENT-BUILT PROJECT</span><h2 id="home-support-title">Finding this useful?</h2><p>Help with the costs of keeping D.El.Ed Buddy running. No pressure.</p></div><a class="button secondary" href="/about/#support">Support the project <Icon name="arrow-up-right" size={18}/></a></div></section>
</Layout>

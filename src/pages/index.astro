---
import Layout from '../layouts/Layout.astro';
import courses from '../data/courses.json';
import CourseCard from '../components/CourseCard.astro';
import {resourceTypes} from '../data/site';
---
<Layout>
<section class="hero wrap">
  <div class="hero-copy">
    <div class="eyebrow"><span class="pill">FOR THE “BRO, SEND THE NOTES” CROWD</span></div>
    <h1>Everything D.El.Ed.<br/><em>in one place.</em></h1>
    <p class="tagline">Because hunting through WhatsApp, Telegram, Drive and random PDFs gets old real quick.</p>
    <p class="hero-description">Notes, practicals, study stuff, notices — basically the things you keep looking for at 11 PM.</p>
    <div class="actions">
      <a class="button" href="/courses/semester-1/">Start studying <span>↗</span></a>
      <a class="text-link" href="/materials/">Browse materials →</a>
    </div>
  </div>
  <aside class="semester-note sidekick-note">
    <div class="note-top"><span>D.El.ED BUDDY</span></div>
    <h2><span>Your semester.</span><span>Your notes.</span><span>Your practicals.</span><span>Your sanity.</span></h2>
    <div class="note-rule"></div>
    <p>Your D.El.Ed. sidekick.</p>
  </aside>
</section>
<section class="search-strip wrap"><span class="search-symbol">⌕</span><form action="/search/"><label class="sr-only" for="home-search">Search the website</label><input id="home-search" name="q" placeholder="What are you studying today? Try “Piaget” or “S1.1”"/><button class="button" type="submit">Search <span>→</span></button></form></section>
<section class="wrap section"><div class="section-heading"><div><div class="eyebrow">YOUR SEMESTER, ORGANIZED</div><h2>Start with your subject</h2></div><a class="text-link" href="/courses/">View all semesters ↗</a></div><div class="semester-tabs"><a class="selected" href="/courses/semester-1/">Semester 1 <span>Available</span></a>{[2,3,4].map(n=><a href={`/courses/semester-${n}/`}>Semester {n}<span>Coming later</span></a>)}</div><div class="grid">{courses.map((c,i)=><CourseCard course={c} index={i}/>)}</div><a class="internship-banner" href="/internship/"><span class="course-symbol">⌂</span><div><span class="eyebrow">SI-I · TWO WEEKS</span><h3>Your first step into the classroom</h3><p>School Internship - I · Activities, source details and a preparation checklist</p></div><span>Explore internship ↗</span></a></section>
<section class="wrap section"><div class="section-heading"><div><span class="eyebrow">MAKE IT YOUR STUDY SESSION</span><h2>How do you like to revise?</h2></div><a href="/materials/" class="text-link">Browse materials ↗</a></div><div class="format-grid home-formats">{resourceTypes.map((type,i)=><a href={`/materials/?type=${encodeURIComponent(type)}`}><span class="format-number">{String(i+1).padStart(2,'0')}</span><span>{type}</span><span>↗</span></a>)}</div></section>
<section class="wrap section"><div class="official-strip"><div><span class="eyebrow">KEEP THE ORIGINAL CLOSE</span><h3>SCERT Assam · Official curriculum</h3><p>The source behind every course outline here.</p></div><a class="button secondary" href="/resources/">Official resources ↗</a></div></section>
<section class="wrap section" aria-labelledby="home-support-title"><div class="home-support"><div><h2 id="home-support-title">Finding this useful?</h2><p>Help with the costs of keeping D.El.Ed Buddy running. No pressure.</p></div><a class="button secondary" href="/about/#support"><span aria-hidden="true">☕</span> Support the project</a></div></section>
</Layout>

<style>
  .sidekick-note h2 span { display: block; }
  .sidekick-note > p { margin-bottom: 0; }
</style>

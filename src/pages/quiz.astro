---
import Layout from '../layouts/Layout.astro';import PageHeader from '../components/PageHeader.astro';import quiz from '../data/quiz.json';
---
<Layout title="Curriculum check"><div class="wrap narrow"><PageHeader title="Know your semester." description="A five-question orientation check based on the supplied curriculum. This is not a subject examination or a prediction of exam questions." kicker="QUICK CURRICULUM CHECK" back="/materials/" backLabel="Study materials"/><section id="quiz" class="content-panel" data-questions={JSON.stringify(quiz)}><div class="quiz-top"><span class="badge">Reference · curriculum orientation</span><span id="quiz-position"></span></div><progress id="quiz-progress" max={quiz.length} value="0"></progress><form id="quiz-form"><fieldset><legend id="quiz-question"></legend><div id="quiz-options"></div></fieldset><button class="button" type="submit" id="quiz-next" disabled>Next question →</button></form><div id="quiz-results" hidden></div></section><section class="section"><details><summary>Prefer to read the questions and answers?</summary>{quiz.map((q,i)=><article class="mcq"><h3>{i+1}. {q.question}</h3><ol type="A">{q.options.map(o=><li>{o}</li>)}</ol><details><summary>Answer & explanation</summary><p><strong>{String.fromCharCode(65+q.answer)}.</strong> {q.explanation}</p><a href={`/curriculum-2024.pdf#page=${q.page}`}>Source page {q.page} ↗</a></details></article>)}</details></section><noscript><p>Use the readable questions and answers below; the interactive score needs JavaScript.</p></noscript></div></Layout>

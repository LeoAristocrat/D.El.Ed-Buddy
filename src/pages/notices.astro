---
import Layout from '../layouts/Layout.astro';import PageHeader from '../components/PageHeader.astro';import {getCollection} from 'astro:content';const notices=(await getCollection('notices',({data})=>data.status==='published')).sort((a,b)=>b.data.date.localeCompare(a.data.date));
---
<Layout title="Notices"><div class="wrap"><PageHeader title="The notice board." description="Important information with a date, a source and a link to the original. Always verify official announcements at the source." kicker="STAY INFORMED" back="/notices/" backLabel="Notices"/>{notices.length?<div class="grid">{notices.map(({data:n})=><article class="card"><span class="badge">{n.category}</span><p class="small">{n.date}</p><h2>{n.title}</h2><p>{n.summary}</p><p>Source: {n.source}</p><a class="text-link" href={n.originalUrl}>Read original notice ↗</a>{n.attachment&&<a href={n.attachment}>Attachment ↓</a>}</article>)}</div>:<div class="empty"><span class="eyebrow">NO PUBLISHED NOTICES</span><h2>A quiet notice board for now.</h2><p>No verified notices have been added to D.El.Ed Buddy. This does not mean there are no current official announcements.</p><a href="https://scertpet.co.in/" class="button">Visit SCERT Assam ↗</a></div>}<p class="small muted spaced">D.El.Ed Buddy shares sourced information. It does not issue official notices or examination schedules.</p></div></Layout>

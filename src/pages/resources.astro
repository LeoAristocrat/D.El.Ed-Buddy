---
import Layout from '../layouts/Layout.astro';import PageHeader from '../components/PageHeader.astro';import {officialLinks} from '../data/site';
---
<Layout title="Official resources"><div class="wrap"><PageHeader title="Go straight to the source." description="A small, useful collection of official places to check curriculum details and find supporting reading." kicker="BOOKMARK-WORTHY REFERENCES" back="/resources/" backLabel="Resources"/><div class="feature-panel"><span class="badge">Official document · supplied copy</span><h2>SCERT Assam · Revised Curriculum 2024</h2><p>The source used for this website’s Semester 1 structure. Check for later revisions with SCERT or your institution.</p><div class="actions"><a class="button" href="/curriculum-2024.pdf" download>Download curriculum ↓</a></div></div><div class="grid spaced">{officialLinks.map(r=><article class="card"><span class="badge">Official website</span><h2>{r.name}</h2><p>{r.description}</p><p>{r.use}</p><a class="text-link" href={r.url}>Visit {r.name} ↗</a></article>)}</div></div></Layout>

---
import Layout from '../layouts/Layout.astro';import PageHeader from '../components/PageHeader.astro';import {getCollection} from 'astro:content';const resources=(await getCollection('resources',({data})=>data.status==='published')).sort((a,b)=>b.data.updatedDate.localeCompare(a.data.updatedDate)||Number(!!b.data.htmlFile)-Number(!!a.data.htmlFile));
---
<Layout title="What’s new"><div class="wrap narrow"><PageHeader title="Growing, one addition at a time." kicker="WHAT’S NEW" back="/updates/" backLabel="Updates"/>{resources.map(r=><article class="content-panel spaced"><span class="eyebrow">{r.data.updatedDate}</span><h2><a href={`/materials/${r.id}/`}>{r.data.title}</a></h2><p>{r.data.description}</p><span class="badge">{r.data.origin}</span></article>)}<div class="source-note"><strong>24 September 2026 · Semester 1 foundation</strong><p>Added nine course outlines, 37 unit pages, the practicum directory and School Internship - I. Subject notes will follow after source checking and human review.</p></div></div></Layout>

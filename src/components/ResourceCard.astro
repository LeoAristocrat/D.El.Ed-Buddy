---
const {resource:r,unit}=Astro.props;const d=r.data;
---
<article class="card resource-card" data-resource data-title={d.title.toLowerCase()} data-type={d.type} data-course={d.course||''} data-unit={d.unit||''} data-units={(d.coversUnits||[]).join(',')} data-difficulty={d.difficulty}><div class="resource-label">{d.type}</div><h3><a href={`/materials/${r.id}/${unit?`?unit=${unit}`:''}`}>{d.title}</a></h3>{!d.htmlFile&&<p>{d.description}</p>}<div class="card-bottom"><span>{d.course?.replace('s1-','S1.')||'Semester 1'}{d.unit?` · Unit ${d.unit}`:''}</span></div></article>
